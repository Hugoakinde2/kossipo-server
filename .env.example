# Copier ce fichier en ".env" (développement local) ou configurer ces mêmes variables
# dans Render (Environment) pour la production.

# ---------------------------------------------------------------------------
# Base de données PostgreSQL — OBLIGATOIRE
# ---------------------------------------------------------------------------
# En local (ex. PostgreSQL installé via Docker) :
#   DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/kossipo
# Sur Render : copier l'"Internal Database URL" fournie par ta base PostgreSQL Render
# (Dashboard -> ta base de donnees -> Connect -> Internal Database URL) -- voir DEPLOIEMENT_RENDER.md.
DATABASE_URL=postgresql://user:password@localhost:5432/kossipo

# ---------------------------------------------------------------------------
# Securite -- OBLIGATOIRE
# ---------------------------------------------------------------------------
# Secret de signature des jetons JWT (API REST). Genere une vraie valeur avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-moi

# Cle partagee pour la synchronisation push/pull avec l'application de bureau Electron
# (voir kossipo-electron). Genere-la avec la meme commande que ci-dessus, une valeur DIFFERENTE.
SYNC_API_KEY=change-moi-aussi

# ---------------------------------------------------------------------------
# CORS -- OBLIGATOIRE en production
# ---------------------------------------------------------------------------
# Liste des origines autorisees a appeler cette API, separees par des virgules -- SANS slash final.
# Doit inclure l'URL exacte de ton deploiement kossipo-admin-web sur Netlify.
# Exemple :
#   CORS_ORIGIN=https://kossipo-admin.netlify.app,https://kossipo-admin.example.com
# Sans cette variable en production, TOUTES les requetes cross-origin sont refusees
# (y compris depuis ton propre site Netlify) -- voir src/index.ts.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Divers
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
